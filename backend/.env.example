# Copy this file to .env and fill in real values. NEVER commit a real .env.

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
# Locally:   sqlite:///./callmind.db
# On Render: paste the "External Database URL" from the Postgres service here.
DATABASE_URL=sqlite:///./callmind.db

# Twilio (paste from console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+15555555555

# JWT - change to a long random string before deploying
JWT_SECRET=change-me-please-use-a-long-random-string-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Matching
MATCH_THRESHOLD=0.60

# Voice defaults
DEFAULT_VOICE=alice
SPEECH_LANGUAGE=en-US

# Owner defaults (used by seed)
DEFAULT_OWNER_NAME=Chetan
DEFAULT_ASSISTANT_NAME=CallMind
DEFAULT_GREETING="Hi, this is Chetan's AI assistant. He's busy right now. What would you like to ask?"
DEFAULT_FALLBACK="Chetan will call you back."
AI_DISCLOSURE_TEXT="This is an AI assistant for Chetan"